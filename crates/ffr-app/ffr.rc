// Windows resources for fast-file-recovery.exe. build.rs fills in the @…@ placeholders.
#include <winver.h>

1 ICON "@ICON@"
1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Akulav"
            VALUE "FileDescription", "Fast File Recovery"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "fast-file-recovery"
            VALUE "LegalCopyright", "Made by Akulav"
            VALUE "OriginalFilename", "fast-file-recovery.exe"
            VALUE "ProductName", "Fast File Recovery"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
